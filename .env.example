# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# Garmin Connect account (garmin-sync, garmin-workouts)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# OpenRouteService API key (route-generator) - https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Start point for generated running loops, decimal degrees (route-generator)
HOME_LAT=
HOME_LON=

# Root folder for your personal data; fitness files go in $MEMORY_DIR/fitness (default: ~/.memory)
MEMORY_DIR=

# Path to your clone of this repository (used by the WOD skills to run tv/build.py)
FITNESS_SKILLS_DIR=

# Optional: Cloudflare Pages project for `tv/build.py --deploy`
CLOUDFLARE_PAGES_PROJECT=
